{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rain.csv (one row)",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "precip_mm"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "precip_mm": { "type": "number", "minimum": 0 }
  }
}
