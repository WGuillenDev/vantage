{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meta.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "files", "area", "passes", "overlays", "rain", "speed_model_kmh", "attributions"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rain_csv_schema"],
      "properties": { "rain_csv_schema": { "type": "string", "minLength": 1 } }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bbox"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bbox": { "$ref": "#/$defs/bbox" }
      }
    },
    "passes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/pass" },
        "after": { "$ref": "#/$defs/pass" }
      }
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "file", "bounds", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^overlay_[a-z0-9_]+\\.png$" },
          "bounds": { "$ref": "#/$defs/bbox" },
          "kind": { "enum": ["delta_db", "backscatter"] },
          "range_db": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "if": { "properties": { "kind": { "const": "delta_db" } }, "required": ["kind"] },
        "then": { "required": ["range_db"] }
      }
    },
    "rain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "start", "end", "aggregation"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "aggregation": { "const": "area_mean" }
      }
    },
    "speed_model_kmh": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "attributions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "contains": { "pattern": "OpenStreetMap" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "granule", "track", "direction", "crid"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "granule": { "type": "string", "minLength": 1 },
        "track": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["ascending", "descending"] },
        "crid": { "type": "string", "minLength": 1 }
      }
    }
  }
}
